{
  "uid": "credexp-serving",
  "title": "Credit scoring - serving",
  "description": "What the scoring service is deciding, and how. Provisioned from infra/grafana/dashboards/serving.json; edits made in the UI are not saved.",
  "tags": [
    "credexp",
    "serving"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Decisions logged",
      "description": "Every scored request since the service started.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum(credexp_threshold_crossings_total)",
          "legendFormat": "decisions",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Acceptance rate",
      "description": "The share of applicants below the business threshold. This is what a lending team reads first, and it moves for reasons the model does not announce.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum(credexp_threshold_crossings_total{decision=\"0\"}) / clamp_min(sum(credexp_threshold_crossings_total), 1)",
          "legendFormat": "accepted",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mean predicted probability",
      "description": "The average score served. Read it against the base rate: the gap is the calibration error, and a mean that walks away from it is a change in who is applying.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum(credexp_default_probability_sum) / clamp_min(sum(credexp_default_probability_count), 1)",
          "legendFormat": "mean score",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests that produced no score",
      "description": "Counted by failure kind, on the failure kinds the service publishes, counted by name. Anything above zero means a caller is being refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum(credexp_prediction_failures_total) or on() vector(0)",
          "legendFormat": "failures",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Predictions per second",
      "description": "Rate over one minute, by endpoint. /predict_batch scores many applicants per request, so the two lines are not comparable in volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum by (endpoint) (rate(credexp_predictions_total[1m]))",
          "legendFormat": "{{endpoint}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Where the scores sit, against the threshold",
      "description": "Median and 90th percentile of the predicted probability, from the histogram buckets. The red line is the business threshold at 0.49; the distance between the curves and that line is what the acceptance rate is made of.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(credexp_default_probability_bucket[5m])))",
          "legendFormat": "median",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(credexp_default_probability_bucket[5m])))",
          "legendFormat": "90th percentile",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 3,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.49
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "How the threshold split the traffic",
      "description": "0 accepted, 1 refused. Two counters, and the whole product sits in the line that compares a probability to 0.49.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum by (decision) (credexp_threshold_crossings_total)",
          "legendFormat": "{{decision}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Applicants scored at or below each probability",
      "description": "The served score distribution, read off the histogram buckets. The shape, not the average, is what shifts first when the incoming population changes, and the step at 0.49 is the acceptance rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum by (le) (credexp_default_probability_bucket{le!=\"+Inf\"})",
          "legendFormat": "under {{le}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "minVizWidth": 8,
        "minVizHeight": 12,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "How long a caller waits",
      "description": "Three quantiles of the whole request, over five minutes: the model call, the validation, the JSON in and out. The gap between the median and the 99th is what a caller notices; the median alone hides it.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/predict.*\"}[5m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/predict.*\"}[5m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/predict.*\"}[5m])))",
          "legendFormat": "p99",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests that failed, by kind",
      "description": "The failure counter the service publishes, by its own closed vocabulary. A flat line at zero is the expected shape; anything else names what went wrong without anyone opening a log.",
      "datasource": {
        "type": "prometheus",
        "uid": "credexp-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credexp-prometheus"
          },
          "expr": "sum by (failure_kind) (rate(credexp_prediction_failures_total[5m]))",
          "legendFormat": "{{failure_kind}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
