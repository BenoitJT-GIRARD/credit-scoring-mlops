# --- Python ---
__pycache__/
*.py[cod]
*.py[oc]
wheels/
*.pyd
*.so
*.egg-info/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/
.mypy_cache/
.ruff_cache/

# --- Virtual envs ---
.venv/
venv/
ENV/
env/

# --- Jupyter / Notebooks ---
.ipynb_checkpoints/
*.nbconvert.ipynb
notebooks/reports/monitoring/*.html
# Coverage output is rewritten by every test run: it dirties the tree for no gain.
reports/coverage/
notebooks/reports/monitoring/*.json

# --- IDEs ---
.vscode/
.idea/
*.iml

# --- OS ---
.DS_Store
Thumbs.db

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- MLflow / local experiment stores ---
mlruns/
mlflow/
mlruns_old/
*.db

# --- Data (NE JAMAIS committer raw Kaggle) ---
data/raw/
data/interim/
data/processed/
!data/**/.gitkeep

# --- Generic temporary exports ---
*.parquet
*.feather
*.pkl
*.joblib

# --- Project artifacts ---
artifacts/explainability/
artifacts/reports/
logs/

# --- Allow only remote deployment model artifacts ---
!artifacts/
!artifacts/models/
!artifacts/models/pipeline.joblib
!artifacts/models/threshold.json
!artifacts/models/feature_columns.json

# --- Optional ONNX artifact: keep ignored unless you explicitly decide to ship it ---
artifacts/models/*.onnx

# --- Reports kept in the repository ---
# The metadata of each monitoring run is versioned; the rendered HTML is not. Evidently
# reports embed their data and one reached 34 MB, which has no business in a git history
# when scripts/monitoring_drift.py regenerates it on demand.
!reports/
!reports/monitoring/
!reports/performance/
reports/monitoring/*.html

# --- Docker local ---
docker-compose.override.yml
