# --- Runtime ---
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
RANDOM_STATE=42

# --- MLflow ---
# Local tracking store (default handled in code if absent)
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=credexp

# --- API / Serving (partie 2) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Database (partie 2) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/credexp

# --- Monitoring / Observability (partie 2) ---
EVIDENTLY_REFERENCE_PATH=./data/processed/reference.parquet
PROMETHEUS_ENABLED=false
