# --- Runtime ---
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
RANDOM_STATE=42

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db
MLFLOW_REGISTRY_URI=sqlite:///mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=mlflow/artifacts
MLFLOW_EXPERIMENT_NAME=credexp

# --- API / Serving ---
API_HOST=127.0.0.1
API_PORT=8000
MODEL_URI=models:/credit_scoring_model/Production

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/credexp

# --- Monitoring / Observability ---
EVIDENTLY_REFERENCE_PATH=./data/processed/reference.parquet
PROMETHEUS_ENABLED=true
