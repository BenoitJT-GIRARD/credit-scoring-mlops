# Every variable this project reads, and what each one changes.
#
# Copy this file to `.env` and edit what you need. `credexp.config` loads it at import, so
# a value set here reaches the API, the scripts and the notebooks alike. Nothing here is a
# secret in this repository: the database is a local container, and the hosted Space it was
# once deployed to is decommissioned.

# --- Runtime ---
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
# The seed every split, every resample and every model takes. One number, so two runs of the
# same script are the same run.
RANDOM_STATE=42

# --- MLflow, during training only ---
# The registry is deliberately not in the serving path: one fewer service to keep alive for
# a model that is not retrained on a schedule.
MLFLOW_TRACKING_URI=sqlite:///var/mlflow/mlflow.db
MLFLOW_REGISTRY_URI=sqlite:///var/mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=var/mlflow/artifacts
MLFLOW_EXPERIMENT_NAME=credexp

# --- The API ---
API_HOST=127.0.0.1
API_PORT=8000
# A prefix when the service is served behind a reverse proxy: FastAPI generates its
# documentation links from it, and without it the OpenAPI page points at the wrong host.
API_ROOT_PATH=

# --- Which model is served, and from where ---
# `joblib` reads the three tracked files under `models/` and is what the containers use.
# `mlflow` resolves a registered version. `auto` tries the registry and falls back.
MODEL_LOAD_MODE=joblib
MODEL_URI=models:/credit_scoring_model/Production
MODEL_NAME=credit_scoring_model
# What `/model-info` reports. `joblib` when the artefact was read from disk.
MODEL_VERSION=joblib
# The three artefacts, when they are somewhere other than `models/`. The container sets them
# to absolute paths inside the image.
MODEL_JOBLIB_PATH=
THRESHOLD_PATH=
FEATURE_COLUMNS_PATH=
MODEL_MANIFEST_PATH=
# Read before `MODEL_LOAD_MODE` existed, and still honoured so that an older `.env` keeps
# working: `true` forces the joblib path.
USE_LOCAL_MODEL=
PIPELINE_PATH=
# The operating point to fall back on when neither the manifest nor `threshold.json` is
# readable. It is a fallback and not a setting: changing it here changes what the service
# decides, and nothing else in the repository records that you did.
DEFAULT_THRESHOLD=0.5

# --- The prediction log ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/credexp
# Seconds `psycopg` may spend opening a connection before it gives up. Writing a prediction
# to the log is best effort; without a deadline, an unreachable database made the service
# take two minutes to start.
DB_CONNECT_TIMEOUT=3

# --- Monitoring ---
EVIDENTLY_REFERENCE_PATH=./var/data/processed/reference.parquet
PROMETHEUS_ENABLED=true

# --- The demonstration interface ---
# Where the Streamlit pages look for the service. The compose file sets it to the service
# name on its own network.
API_BASE_URL=http://127.0.0.1:8000
