# Line endings are normalised to LF in the repository, whatever the platform commits.
* text=auto eol=lf

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts are the exception: a shell that reads them needs CRLF.
*.ps1 text eol=crlf

# Notebooks are JSON. They are text, but never merged by union: git would splice two
# versions into a file no reader can open, and report no conflict.
*.ipynb text eol=lf

# Binary: never converted on checkout, never diffed as text.
*.png binary
*.joblib binary
